# AlphaHunter AI - copy to .env and adjust
# --- core ---
# Local demo: APP_ENV=local and DEMO_MODE=true. Compose always forces production, demo off.
APP_ENV=local
# Generate a new random key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Production only: HTTPS reverse-proxy origin; bootstrap once, then remove password from .env.
PUBLIC_ORIGIN=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# --- database ---
# Light default: one SQLite file, no extra service.
DATABASE_URL=sqlite:////data/alphahunter.db

# --- mode (both are forced to paper/false at runtime, listed for clarity) ---
TRADING_MODE=paper
ENABLE_LIVE_EXECUTION=false
# true = deterministic fixtures, zero network traffic. Use it to exercise the full path.
DEMO_MODE=true

# --- free data providers (no api key needed) ---
GT_BASE=https://api.geckoterminal.com/api/v2
DEXSCREENER_BASE=https://api.dexscreener.com
BINANCE_BASE=https://api.binance.com
BYBIT_BASE=https://api.bybit.com
COINGECKO_BASE=https://api.coingecko.com/api/v3

# --- optional paid adapters (leave empty to stay on free endpoints) ---
HELIUS_API_KEY=
BIRDEYE_API_KEY=
LUNARCRUSH_API_KEY=

# --- optional LLM phrasing for the explainable layer (OpenAI compatible) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- notifications (optional, PRD 26) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=0

# --- scan universe (cost guardrail: shrink these to spend less) ---
CHAINS=solana
MAX_POOLS_PER_SCAN=12
NEW_POOLS_PER_SCAN=6
SCAN_INTERVAL_S=60
SCAN_TIMEOUT_S=30

# --- risk ---
DAILY_LOSS_CAP_PCT=5
MAX_DRAWDOWN_CAP_PCT=20
MAX_POSITIONS=5
DATA_COST_BUDGET_USD_PER_DAY=0

# --- gates (PRD 11.3 / 13 / 15.2) ---
MAX_SLIPPAGE_BPS=150
DEPTH_MULTIPLE=10
MAX_SIGNAL_AGE_S=1800
MAX_CHASE_PCT=4
MAX_PCT_OF_WHALE_SIZE=0.25
MIN_POOL_LIQUIDITY_USD=15000
MIN_WHALE_TRADE_USD=1000
COMPOSITE_BUY_THRESHOLD=85
COMPOSITE_WATCH_THRESHOLD=70